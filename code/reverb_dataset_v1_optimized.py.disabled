#!/usr/bin/env python3
# -*- coding: UTF-8 -*-
"""
Optimized reverb_dataset_v1: MT-fill + pin_memory + async H2D + fixed locking.
Drop-in replacement for reverb_dataset_v1.ReverbDataset.
"""

from collections import deque
import torch
import numpy as np
import reverb
from common_python.config.config_control import CONFIG
from kaiwudrl.common.utils.kaiwudrl_define import KaiwuDRLDefine
import threading
import time


class ReverbDataset(torch.utils.data.IterableDataset):

    def __init__(self, logger):
        super().__init__()
        self._table_names = [
            "{}_{}".format(CONFIG.reverb_table_name, i)
            for i in range(int(CONFIG.reverb_table_size))
        ]
        self.device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
        self.logger = logger

        buf_cap = CONFIG.train_batch_size * CONFIG.replay_buffer_cache_multiplier

        # Single lock for both read and write (fixes race in original V1)
        self._lock = threading.Lock()

        self.active_buffer = deque(maxlen=buf_cap)
        self.backup_buffer = deque(maxlen=buf_cap)

        self._stop_event = threading.Event()
        self.client = None
        self._fill_thread = None
        self._fill_workers = []

        # CUDA async copy stream (from V2)
        self.copy_stream = None
        if self.device.type == "cuda":
            self.copy_stream = torch.cuda.Stream(device=self.device)

        # pin_memory probe (from V2)
        self._pin_ok = False
        if self.device.type == "cuda":
            try:
                torch.empty(1).pin_memory()
                self._pin_ok = True
            except Exception:
                pass

    def start_background_filler(self):
        if self._fill_thread is not None:
            return
        self._stop_event.clear()
        self.client = reverb.Client(f"localhost:{CONFIG.reverb_svr_port}")

        n_workers = getattr(CONFIG, "fill_threads", 3) or 3
        for _ in range(n_workers):
            t = threading.Thread(target=self._fill_worker, daemon=True)
            t.start()
            self._fill_workers.append(t)

        self._fill_thread = threading.Thread(
            target=self._coordinator_loop, daemon=True
        )
        self._fill_thread.start()
        self.logger.info(
            f"[V1-opt] MT fill started: {n_workers} workers + 1 coordinator, "
            f"pin_memory={self._pin_ok}, buf_cap={self.active_buffer.maxlen}"
        )

    def _fill_worker(self):
        """Each worker independently samples from reverb into backup_buffer."""
        while not self._stop_event.is_set():
            try:
                data = self.client.sample(
                    table=self._table_names[0],
                    num_samples=CONFIG.train_batch_size,
                )
                if data:
                    # deque.extend is thread-safe for append operations
                    self.backup_buffer.extend(data)
                else:
                    time.sleep(CONFIG.idle_sleep_second)
            except Exception as e:
                self.logger.error(f"[V1-opt] fill worker error: {e}")
                time.sleep(CONFIG.idle_sleep_second)

    def _coordinator_loop(self):
        """Swap buffers when active is depleted and backup has enough."""
        coord_sleep = getattr(CONFIG, "coordinator_sleep", 0.05) or 0.05
        while not self._stop_event.is_set():
            time.sleep(coord_sleep)
            with self._lock:
                if (
                    len(self.active_buffer) < CONFIG.train_batch_size
                    and len(self.backup_buffer) >= CONFIG.train_batch_size
                ):
                    self.active_buffer, self.backup_buffer = (
                        self.backup_buffer,
                        self.active_buffer,
                    )
                    self.backup_buffer.clear()

    def __iter__(self):
        self.start_background_filler()

        prefetch_gpu = None

        while True:
            with self._lock:
                if len(self.active_buffer) >= CONFIG.train_batch_size:
                    batch = [
                        self.active_buffer.popleft()
                        for _ in range(CONFIG.train_batch_size)
                    ]
                else:
                    batch = None

            if batch is None:
                # Yield prefetched result while waiting for data
                if prefetch_gpu is not None:
                    torch.cuda.current_stream(self.device).wait_stream(
                        self.copy_stream
                    )
                    yield prefetch_gpu
                    prefetch_gpu = None
                time.sleep(CONFIG.idle_sleep_second)
                continue

            raw_batch = [sample[0].data[0] for sample in batch]
            batch_cpu = self._process_batch(raw_batch)

            if self.device.type != "cuda":
                yield batch_cpu
                continue

            # ---- CUDA double-buffer pipeline (from V2) ----
            if prefetch_gpu is not None:
                torch.cuda.current_stream(self.device).wait_stream(self.copy_stream)
                yield prefetch_gpu

            with torch.cuda.stream(self.copy_stream):
                prefetch_gpu = batch_cpu.to(self.device, non_blocking=True)

    def _process_batch(self, batch_data):
        """Optimized batch processing with optional pin_memory."""
        first = batch_data[0]

        if isinstance(first, torch.Tensor):
            cpu_tensors = [t.detach().cpu() if t.device.type != "cpu" else t.detach() for t in batch_data]
            out = torch.stack(cpu_tensors, dim=0).contiguous().float()
        elif isinstance(first, np.ndarray):
            stacked = np.stack(batch_data, axis=0)
            if not stacked.flags["C_CONTIGUOUS"]:
                stacked = np.ascontiguousarray(stacked)
            out = torch.from_numpy(stacked).float().clone()
        else:
            raise TypeError(f"Unsupported type: {type(first)}")

        if self._pin_ok:
            try:
                return out.pin_memory()
            except Exception:
                self._pin_ok = False
                return out
        return out

    def __del__(self):
        self._stop_event.set()
        for t in self._fill_workers:
            t.join(timeout=2)
        if self._fill_thread is not None:
            self._fill_thread.join(timeout=2)

    def get_metrics(self):
        return {"buffer_utilization": f"{len(self.active_buffer)}/{self.active_buffer.maxlen}"}
